  <changeSet id="reset-menu-item-upnp-order" author="tesshucom">
    <preConditions onFail="MARK_RAN">
        <tableExists tableName="menu_item" />
    </preConditions>
    <sql>
      update menu_item set menu_item_order = 1 where id = 10;
      update menu_item set menu_item_order = 2 where id = 20;
      update menu_item set menu_item_order = 3 where id = 30;
      update menu_item set menu_item_order = 4 where id = 40;
      update menu_item set menu_item_order = 5 where id = 90;
      update menu_item set menu_item_order = 6 where id = 50;
      update menu_item set menu_item_order = 7 where id = 60;
      update menu_item set menu_item_order = 8 where id = 70;
      update menu_item set menu_item_order = 9 where id = 80;
    </sql>
    <rollback>
    </rollback>
  </changeSet>
  <changeSet id="add-year-browse-indexes" author="tesshucom">
      <createIndex indexName="idx_album_folder_id" tableName="album">
          <column name="folder_id"/>
      </createIndex>
      <createIndex indexName="idx_media_file_album_artist_type_year" tableName="media_file">
          <column name="album"/>
          <column name="album_artist"/>
          <column name="type"/>
          <column name="year"/>
      </createIndex>
      <createIndex indexName="idx_album_order" tableName="album">
          <column name="album_order"/>
      </createIndex>
  </changeSet>
</databaseChangeLog>
