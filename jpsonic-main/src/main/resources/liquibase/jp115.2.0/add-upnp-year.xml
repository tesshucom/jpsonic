<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
  <changeSet id="add-menu-item-upnp-year" author="tesshucom">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">select count(*) from menu_item
        where id = 90
      </sqlCheck>
    </preConditions>
    <insert tableName="menu_item">
      <column name="view_type" valueNumeric="1" />
      <column name="id" valueNumeric="90" />
      <column name="parent" valueNumeric="0" />
      <column name="name" value="" />
      <column name="enabled" valueBoolean="true" />
      <column name="menu_item_order" valueNumeric="4" />
    </insert>
    <rollback>
      <delete tableName="menu_item">
        <where>id = 90</where>
      </delete>
    </rollback>
  </changeSet>
